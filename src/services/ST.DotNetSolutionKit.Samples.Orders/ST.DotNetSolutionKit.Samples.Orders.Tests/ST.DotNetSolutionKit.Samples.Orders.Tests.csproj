<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Run through VSTest, like the other test projects: xunit.v3 marks itself a Microsoft.Testing.Platform
             app, which a .NET 10 SDK then refuses to run under dotnet test's VSTest target. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
      <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common.Application\ST.DotNetSolutionKit.Samples.Common.Application.csproj" />
      <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common.Infrastructure\ST.DotNetSolutionKit.Samples.Common.Infrastructure.csproj" />
      <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common.Web\ST.DotNetSolutionKit.Samples.Common.Web.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Orders\ST.DotNetSolutionKit.Samples.Orders.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Orders.Application\ST.DotNetSolutionKit.Samples.Orders.Application.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Orders.Infrastructure\ST.DotNetSolutionKit.Samples.Orders.Infrastructure.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Orders.API\ST.DotNetSolutionKit.Samples.Orders.API.csproj" />
      <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common.Testing\ST.DotNetSolutionKit.Samples.Common.Testing.csproj" />
      <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common.Contracts\ST.DotNetSolutionKit.Samples.Common.Contracts.csproj" />
    </ItemGroup>

</Project>
