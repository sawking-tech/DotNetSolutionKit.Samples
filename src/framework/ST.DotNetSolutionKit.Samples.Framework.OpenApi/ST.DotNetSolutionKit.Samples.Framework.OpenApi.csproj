<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The OpenAPI surface over Swashbuckle: the Swagger setup with its filters
      (authorization, permissions, versioned documents, schema values, description
      scrubbing), the schema-only mode with its dump (DiffApi), the pagination
      operation filter, and the gateway's view of the services' documents.
      See the Readme and template/src/framework/README.md.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common.Contracts\ST.DotNetSolutionKit.Samples.Common.Contracts.csproj" />
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common.Application\ST.DotNetSolutionKit.Samples.Common.Application.csproj" />
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common.Infrastructure\ST.DotNetSolutionKit.Samples.Common.Infrastructure.csproj" />
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Framework.Auth\ST.DotNetSolutionKit.Samples.Framework.Auth.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Framework.FeatureFlags\ST.DotNetSolutionKit.Samples.Framework.FeatureFlags.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ST.DotNetSolutionKit.Samples.Framework.OpenApi.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
