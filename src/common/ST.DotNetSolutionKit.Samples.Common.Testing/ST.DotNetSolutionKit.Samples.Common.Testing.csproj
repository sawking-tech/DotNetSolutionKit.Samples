<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Test helpers tied to an external system: the PostgreSQL and SQL Server test databases and the
      audit verifiers. The portable harness (execution contexts, stubs, rules) lives in
      ST.DotNetSolutionKit.Samples.Framework.Testing, referenced below. No test framework here; a test
      project adds its own and tells TestSkip how that framework skips a test.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <!-- The remaining types keep the namespaces they had in Common.Tests, so tests written against them still build. -->
        <RootNamespace>ST.DotNetSolutionKit.Samples.Common.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Application\ST.DotNetSolutionKit.Samples.Common.Application.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Infrastructure\ST.DotNetSolutionKit.Samples.Common.Infrastructure.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Contracts\ST.DotNetSolutionKit.Samples.Common.Contracts.csproj" />
      <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Web\ST.DotNetSolutionKit.Samples.Common.Web.csproj" />
      <ProjectReference Include="..\..\framework\ST.DotNetSolutionKit.Samples.Framework.Testing\ST.DotNetSolutionKit.Samples.Framework.Testing.csproj" />
    </ItemGroup>

</Project>
