<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Contracts\ST.DotNetSolutionKit.Samples.Common.Contracts.csproj" />
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Application\ST.DotNetSolutionKit.Samples.Common.Application.csproj" />
        <ProjectReference Include="..\..\capabilities\ST.DotNetSolutionKit.Samples.Capabilities.Persistence\ST.DotNetSolutionKit.Samples.Capabilities.Persistence.Abstractions\ST.DotNetSolutionKit.Samples.Capabilities.Persistence.Abstractions.csproj" />
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Common.Infrastructure\ST.DotNetSolutionKit.Samples.Common.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Span" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>

    <!-- The web pipeline is assembled here (PlatformWebHost), and its auth and validation wiring
         live in the mandatory Framework modules (ADR-009): the kernel references the modules the
         way DbContextBase references Framework.DomainEvents. -->
    <ItemGroup>
        <ProjectReference Include="..\..\framework\ST.DotNetSolutionKit.Samples.Framework.Auth\ST.DotNetSolutionKit.Samples.Framework.Auth.csproj" />
        <ProjectReference Include="..\..\framework\ST.DotNetSolutionKit.Samples.Framework.OpenApi\ST.DotNetSolutionKit.Samples.Framework.OpenApi.csproj" />
        <ProjectReference Include="..\..\framework\ST.DotNetSolutionKit.Samples.Framework.Validation\ST.DotNetSolutionKit.Samples.Framework.Validation.csproj" />
        <ProjectReference Include="..\..\framework\ST.DotNetSolutionKit.Samples.Framework.Observability\ST.DotNetSolutionKit.Samples.Framework.Observability.csproj" />
    </ItemGroup>

    <!-- The Swagger document leaves the endpoints behind a closed [FeatureGate] out; the filters
         live in the FeatureFlags module and arrive with the flag. -->
    <ItemGroup>
        <ProjectReference Include="..\..\framework\ST.DotNetSolutionKit.Samples.Framework.FeatureFlags\ST.DotNetSolutionKit.Samples.Framework.FeatureFlags.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ST.DotNetSolutionKit.Samples.Common.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
