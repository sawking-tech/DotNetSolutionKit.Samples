<Project Sdk="Microsoft.NET.Sdk">

    <!-- ClickHouse of the flag ClickHouse: connections, the schema guard, the readiness check and
         value helpers. A service with the flag references it, so only that service carries the
         ClickHouse driver. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="ClickHouse.Client" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common.Contracts\ST.DotNetSolutionKit.Samples.Common.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ST.DotNetSolutionKit.Samples.Capabilities.ClickHouse.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
