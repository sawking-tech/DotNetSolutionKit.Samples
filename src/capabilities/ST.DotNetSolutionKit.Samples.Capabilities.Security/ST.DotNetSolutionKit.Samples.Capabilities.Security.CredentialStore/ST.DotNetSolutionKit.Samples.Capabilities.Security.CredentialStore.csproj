<Project Sdk="Microsoft.NET.Sdk">

    <!-- The secret stores of the flags Infisical and Vault: the configuration providers that overlay
         a service's configuration with the shared and its own folder or path, behind ISecretStore.
         A service with a flag references it, so only that service carries the store's SDK. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Infisical.Sdk" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ST.DotNetSolutionKit.Samples.Capabilities.Security.CredentialStore.Abstractions\ST.DotNetSolutionKit.Samples.Capabilities.Security.CredentialStore.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\common\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ST.DotNetSolutionKit.Samples.Capabilities.Security.CredentialStore.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <Using Include="ST.DotNetSolutionKit.Samples.Capabilities.Security.CredentialStore.Abstractions" />
    </ItemGroup>

</Project>
