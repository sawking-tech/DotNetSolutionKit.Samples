<Project Sdk="Microsoft.NET.Sdk">

    <!-- MongoDB of the flag MongoDB, beside the main database: the store, its options and its health check.
         A service with the flag references it, so only that service carries the MongoDB driver. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="MongoDB.Driver" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common\ST.DotNetSolutionKit.Samples.Common.csproj" />
        <ProjectReference Include="..\..\common\ST.DotNetSolutionKit.Samples.Common.Contracts\ST.DotNetSolutionKit.Samples.Common.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ST.DotNetSolutionKit.Samples.Capabilities.Mongo.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
