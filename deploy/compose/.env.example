# Copy to deploy/compose/.env and fill in. The .env file is ignored by git.
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=app
RABBITMQ_ERLANG_COOKIE=
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Basic auth for the background jobs dashboard at /hangfire, at least 12 characters.
HANGFIRE_DASHBOARD_PASSWORD=
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=app
# Email: mailhog catches everything on a local stack; name a real server to send for real.
EMAIL_FROM=noreply@localhost
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
# Every message goes to EMAIL_SANDBOX while EMAIL_SANDBOX_ENABLED is true; false sends to the recipients.
EMAIL_SANDBOX_ENABLED=true
EMAIL_SANDBOX=sandbox@localhost
MONGO_USER=app
# Goes into the connection string as is: letters, digits, - and _, or percent-encode the rest.
MONGO_PASSWORD=
# Object storage: the bucket the services use, and its credentials.
S3_BUCKET=app
S3_ACCESS_KEY=app
S3_SECRET_KEY=
# Calls between services present this key; empty closes the internal API.
INTERNAL_API_KEY=
# For a gateway generated with --ApiGateway: what the tokens carry. Its public key goes to
# deploy/compose/keys/jwt-public.pem.
JWT_ISSUER=
JWT_AUDIENCE=
# The machine identity of the secret store; leave empty and set INFISICAL_ENABLED=false to run without it.
INFISICAL_ENABLED=true
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Where images are pushed and pulled, and their tag; see deploy/build-images.sh.
REGISTRY=local
TAG=latest
